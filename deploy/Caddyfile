# Caddyfile for Forest Wheel Photo Pipeline Web App
# Automatic HTTPS (Let's Encrypt / ZeroSSL) is enabled by default in Caddy for plateremoval.forestwheel.com.

plateremoval.forestwheel.com {
    encode zstd gzip

    request_body {
        max_size 100MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy 127.0.0.1:8000
}
